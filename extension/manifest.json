{
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'"
  },
  "name": "Codex 飞书侧栏",
  "version": "3.0",
  "description": "在 Chrome 侧栏用本机 Codex 阅读和编辑飞书文档。",
  "key": "",
  "permissions": [
    "sidePanel",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "icons": {
    "16": "icons/sidepanel-16.png",
    "32": "icons/sidepanel-32.png",
    "48": "icons/sidepanel-48.png",
    "128": "icons/sidepanel-128.png"
  },
  "action": {
    "default_title": "打开 Codex 飞书侧栏",
    "default_icon": {
      "16": "icons/sidepanel-16.png",
      "32": "icons/sidepanel-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "workspace.html"
  }
}
